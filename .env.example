# Base URL of the PennPromise backend API (no trailing slash).
# TODO(api-contract): confirm the real value and path prefix with backend.
NEXT_PUBLIC_API_BASE_URL=https://api.dev.pennpromise.example

# Optional: URL of the backend's OpenAPI schema document, used by `npm run sync:schema`.
API_SCHEMA_URL=https://api.dev.pennpromise.example/api/schema/

# DEV ONLY. When "true", the client AuthGuard + SessionMonitor are bypassed so the
# whole authenticated app is reachable without a backend login. The UI is being
# built against mock data with no endpoints wired yet. Never set this in production.
NEXT_PUBLIC_DISABLE_AUTH=true
